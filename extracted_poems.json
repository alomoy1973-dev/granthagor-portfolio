    "content_lines": [
      "চিগোন্ চিজি বেন্ বুনে,",
      "আলক্ তুলি ব'হাদি।",
      "সনার চিজি হুন্ হুনার,",
      "বেক্কুনে শুন' হান্ পাদি।",
      "__STANZA__",
      "মক্যা গাজর ছচ্ছেক্ বাশঁ,",
      "জেদেনা গাজ' বিয়োঙ্,",
      "বিয়োঙ্ আবারায় গুরুঙ্ গুরুঙ্,",
      "গুজুরি উদে হুয়োঙ্।",
      "__STANZA__",
      "ফুল্ তুলে তেহ্ চোখ্ হাদি,",
      "বেক্ ফুলুন্ তার মনত্ আগে।",
      "বিঞ্যাঁ বাজে বিল্যা হাবে,",
      "মাসমূলা তার ন' লাগে।।।"
    ],
    "date": "১৯/১২/২০১৪"
  },
  {
